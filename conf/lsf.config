/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    LSF executor configuration for DTU HPC
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow submits each process as a separate bsub job.
    Parallel processes run on different nodes simultaneously.
----------------------------------------------------------------------------------------
*/

process {
    executor = 'lsf'
    queue    = 'hpc'
    // Add -M per-slot hard kill limit at 5% above the rusage reservation.
    // With LSB_JOB_MEMLIMIT=N (shadow lsf.conf), LSF treats -M as per-slot:
    // total enforcement = (declared_MB × 1.05 / cpus) × cpus = declared × 1.05.
    // perJobMemLimit is kept false — relying on it generates conflicting -R strings
    // with DTU HPC's LSB_JOB_MEMLIMIT=Y without the shadow, and the shadow is not
    // guaranteed to be active in all contexts. Explicit clusterOptions is safer.
    clusterOptions = { "-M ${(int)(task.memory.toMega() * 1.05 / task.cpus)}" }
}

executor {
    name          = 'lsf'
    // Reduced from 150 → 80 after HPC staff complaint (Mar 2026), then 80 → 50 (May 2026):
    // all per-sample modules now have explicit maxForks caps, so queueSize is no longer the
    // primary protection — it bounds total LSF submissions and LSF daemon polling load.
    // At queueSize=80 with maxForks in place, peak QC phase could still submit 80 jobs × 8 CPUs
    // = 640 slots from a single user. 50 is a more neighbourly ceiling while keeping the
    // pipeline fast (UNICYCLER at maxForks=6 is the real bottleneck, not queueSize).
    queueSize     = 50
    // pollInterval: how often NF polls bjobs to check job status.
    // Each poll is a real bjobs call that loads the LSF daemon — keep reasonably short.
    pollInterval  = '2 min'
    // perJobMemLimit = false → NF divides -M (kill limit) by CPUs (per-slot kill limit).
    // DTU HPC lsf.conf has LSB_JOB_MEMLIMIT=Y which NF auto-detects as perJobMemLimit=true
    // (disabling -M division). setup.sh shadows lsf.conf with LSB_JOB_MEMLIMIT=N to fix this.
    perJobMemLimit = false
    // perTaskReserve = true → NF divides rusage[mem=X] by CPUs, generating a single clean
    // -R "select[mem>=<total>] rusage[mem=<per-slot>]" string.
    // DTU HPC lsf.conf does not set RESOURCE_RESERVE_PER_TASK, so we set it explicitly.
    // This replaces the previous clusterOptions last-wins workaround.
    perTaskReserve = true
}
